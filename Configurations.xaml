                        CornerRadius="10"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        Margin="0,0,10,8"
                        BorderWidth="0"
                        Clicked="Minutes1"
                        HorizontalOptions="End"
                        Grid.Row="16"
                        Grid.Column="2"/>











                <!-- ===== EnableOption (Row 12) ===== -->
                <Label x:Name="EnableOptionLabel"
                       Text="Включити UDP"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="12,0,8,16"
                       Grid.Row="18"
                       Grid.Column="0"
                       Grid.ColumnSpan="2">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEnableOptionTapped" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Квадрат-индикатор справа -->
                <Border x:Name="EnableOptionBox"
                    Grid.Row="18"
                    Grid.Column="2"
                    HeightRequest="26"
                    WidthRequest="26"
                    Stroke="White"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 4"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Margin="0,0,18,16">
                    <Label x:Name="EnableOptionCheck"
                       Text=""
                       FontSize="18"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center"/>
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnUDP1Tapped" />
                    </Border.GestureRecognizers>
                </Border>


              
                <!-- ===== EnableAck (Row 13) ===== -->
                <Label x:Name="EnableAckLabel"
                   Text="Включити ACK"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   Margin="12,10,8,16"
                   Grid.Row="19"
                   Grid.Column="0"
                   Grid.ColumnSpan="2">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnEnableACK1Tapped" />
                    </Label.GestureRecognizers>
                </Label>





                <Border x:Name="EnableAckBox"
                    Grid.Row="19"
                    Grid.Column="2"
                    HeightRequest="26"
                    WidthRequest="26"
                    Stroke="White"
                    StrokeThickness="2"
                    BackgroundColor="Transparent"
                    StrokeShape="RoundRectangle 4"
                    HorizontalOptions="End"
                    VerticalOptions="Center"
                    Margin="0,10,18,16">
                                <Label x:Name="EnableAckCheck"
                       Text=""
                       FontSize="18"
                       TextColor="White"
                       HorizontalTextAlignment="Center"
                       VerticalTextAlignment="Center" />
                    <Border.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnACK1Tapped" />
                    </Border.GestureRecognizers>
                </Border>









            </Grid>







            <Grid ColumnDefinitions="Auto,*,Auto"
      ColumnSpacing="10"
      HeightRequest="50"
      WidthRequest="320">
                <Label Grid.Column="0"
           Margin="4,15,0,0"
           Text="Включити термінал"
           TextColor="#FFFFFF"
           FontSize="22"
           FontAttributes="Bold"
           VerticalOptions="Center"
           HorizontalOptions="Start">
                    <Label.Shadow>
                        <Shadow Brush="Black" Radius="8" Offset="2,2" Opacity="0.6"/>
                    </Label.Shadow>
                </Label>

                <Switch Grid.Column="2"
            x:Name="TerminalSwitch"
            OnColor="#1046B0"
            ThumbColor="White"
            Margin="0,15,4,0"
            VerticalOptions="Center"
            HorizontalOptions="End"
            Toggled="OnTerminalToggled"/>
            </Grid>

            <Border x:Name="TerminalBorder"
        IsVisible="False"
        Stroke="#0B0101"
        StrokeThickness="2"
        StrokeShape="RoundRectangle 10"
        BackgroundColor="#4A9192"
        Padding="10"
        Margin="0,15,0,0"
        HeightRequest="510"
        WidthRequest="345">

                <Grid RowDefinitions="Auto,*">
                    <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,5">
                        <Label Text="🖥️ Термінал"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="#000000"
                   VerticalOptions="Center"/>

                        <Button Text="🗑️ Очистити"
                    BackgroundColor="#FFFFFF"
                    TextColor="#000000"
                    FontAttributes="Bold"
                    FontSize="14"
                    Padding="5,2"
                    CornerRadius="5"
                    Clicked="OnClearTerminalClicked"/>
                    </HorizontalStackLayout>

                    <ScrollView Grid.Row="1" x:Name="scrollView" VerticalOptions="Fill">
                        <Label x:Name="label4"
                   Text="Empty text to receive data"
                   FontAttributes="Bold"
                   FontSize="18"
                   TextColor="Black"
                   LineBreakMode="WordWrap"
                   VerticalTextAlignment="Start"
                   HorizontalTextAlignment="Start"/>
                    </ScrollView>
                </Grid>

            </Border>








