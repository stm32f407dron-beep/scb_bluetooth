                       Grid.Column="0">
                                    <Label.GestureRecognizers>
                                        <TapGestureRecognizer Tapped="OnServerPortTapped"
                                              CommandParameter="2|Minutes1" />
                                    </Label.GestureRecognizers>
                                </Label>

