                   TextColor="White"
                   BackgroundColor="#232323"
                   Margin="10,0,10,0"
                   VerticalOptions="Center"
                   HorizontalOptions="Fill"
                   HeightRequest="44"
                   Grid.Row="4"
                   Grid.Column="0"
                   Grid.ColumnSpan="2" />

                <!-- Кнопка -->
                <Button Text="⏺️"
                    BackgroundColor="#313131"
                    TextColor="#000000"
                    FontSize="32"
                    CornerRadius="10"
                    HeightRequest="44"
                    WidthRequest="44"
                    Padding="0"
                    Margin="0,0,10,0"
                    BorderWidth="0"
                    Clicked="AccessPoint1"
                    HorizontalOptions="End"
                    Grid.Row="4"
                    Grid.Column="2" />

            

                <!-- ===== IpServer1 (Row 6-7) ===== -->

                <!-- Заголовок -->
                <Label x:Name="IpServer1tLabel"
                       Text="Ip Адреса"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="12,0,8,0"
                       Grid.Row="6"
                       Grid.Column="0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServerPortTapped"
                                  CommandParameter="2|ipServer1" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Значение (получит широкую колонку и IP будет помещаться лучше) -->
                <Label x:Name="IpServer1ValueLabel"
                       Text="empty"
                       FontSize="18"
                       TextColor="#A9A9B0"
                       FontAttributes="Bold"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="End"
                       Margin="0,0,5,0"
                       Grid.Row="6"
                       Grid.Column="1"
                       MaxLines="2"
                       LineBreakMode="TailTruncation" />

                <!-- Entry -->
                <Entry x:Name="IpServer1Entry"
                       Placeholder="Введите значение"
                       Keyboard="Text"
                       MaxLength="20"
                       TextChanged="IpServer1Entry_TextChanged"
                       FontSize="18"
                       TextColor="White"
                       BackgroundColor="#232323"
                       Margin="10,0,10,8"
                       HeightRequest="44"
                       Grid.Row="7"
                       Grid.Column="0"
                       Grid.ColumnSpan="2" />

                <!-- Кнопка -->
                <Button Text="⏺️"
                        BackgroundColor="#313131"
                        TextColor="#000000"
                        FontSize="32"
                        CornerRadius="10"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        Margin="0,0,10,0"
                        BorderWidth="0"
                        Clicked="IpServer1"
                        HorizontalOptions="End"
                        Grid.Row="7"
                        Grid.Column="2" />


                <!-- ===== ServerPort (Row ) ===== -->
                <!-- ===== ServerPort1 (4-я секция) ===== -->

                <!-- Заголовок (Row 9) -->
                <Label x:Name="ServerPortLabel"
                       Text="Порт сервера"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="12,0,8,0"
                       Grid.Row="9"
                       Grid.Column="0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServerPortTapped"
                              CommandParameter="2|ServerPort1" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Значение (Row 9) -->
                <Label x:Name="ServerPortValueLabel"
                       Text="empty"
                       FontSize="18"
                       TextColor="#A9A9B0"
                       FontAttributes="Bold"
                       HorizontalOptions="Fill"
                       HorizontalTextAlignment="End"
                       Margin="0,0,10,0"
                       Grid.Row="9"
                       Grid.Column="1"
                       MaxLines="1"
                       LineBreakMode="TailTruncation"/>

                <!-- Entry (Row 10) -->
                <Entry x:Name="ServerPortEntry"
