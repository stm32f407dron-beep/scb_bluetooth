                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        Margin="0,0,10,8"
                        BorderWidth="0"
                        Clicked="Hours1"
                        HorizontalOptions="End"
                        Grid.Row="13"
                        Grid.Column="2"/>

                                <!-- ===== Minutes1 ===== -->
                                <Label x:Name="Minutes1Label"
