                       Keyboard="Numeric"
                       MaxLength="5"
                       TextChanged="ServerPortEntry_TextChanged"
                       FontSize="18"
                       TextColor="White"
                       BackgroundColor="#232323"
                       Margin="10,0,10,16"
                       HeightRequest="44"
                       Grid.Row="10"
                       Grid.Column="0"
                       Grid.ColumnSpan="2"/>

                <!-- Кнопка (Row 10) -->
                <Button Text="⏺️"
                        BackgroundColor="#313131"
                        TextColor="#000000"
                        FontSize="32"
                        CornerRadius="10"
                        HeightRequest="44"
                        WidthRequest="44"
                        Padding="0"
                        Margin="0,0,10,8"
                        BorderWidth="0"
                        Clicked="ServerPort1"
                        HorizontalOptions="End"
                        Grid.Row="10"
                        Grid.Column="2"/>



                <!-- ===== Hours1 ===== -->
                                <Label x:Name="Hours1Label"
                       Text="Години"
                       FontSize="18"
                       FontAttributes="Bold"
                       TextColor="White"
                       Margin="12,0,8,0"
