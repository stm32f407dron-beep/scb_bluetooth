<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="skb_home.Configurations"
             Title="Конфігурація"
             BackgroundColor="#181818"
             >
    <ScrollView>
        <VerticalStackLayout Spacing="22" Padding="0,20,0,0">




            <!-- Одна общая "карточка" (один овальный фон) для CodeObject1 + AccessPoint1 + IpServer1  "Auto,Auto,12,Auto,Auto,12,Auto,Auto,12,Auto,Auto,12,Auto,Auto,16" :  RowDefinitions="Auto,Auto,12,Auto,Auto,12,Auto,Auto,12,Auto,Auto,12,Auto,Auto,16"  -->
            <Grid Margin="10,0,10,0"
                  Padding="0,0,0,12"
                  ColumnDefinitions="Auto,*,70"
                  RowDefinitions="Auto,Auto,12,Auto,Auto,12,Auto,Auto,12,Auto,Auto,12,Auto,Auto,12,Auto,Auto,12,Auto,Auto,16">

                <!-- Общий овальный фон на ВСЮ карточку -->
                <BoxView CornerRadius="18"
                     BackgroundColor="#242424"
                     HorizontalOptions="Fill"
                     VerticalOptions="Fill"
                     Grid.Row="0"
                     Grid.RowSpan="20"
                     Grid.Column="0"
                     Grid.ColumnSpan="3" />

                <!-- ===== CodeObject1 (Row 0-1) ===== -->

                <!-- Заголовок -->
                <Label x:Name="CodeObject1Label"
                   Text="Обьект № 1"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Start"
                   HorizontalOptions="Start"
                   Margin="12,16,8,0"
                   Grid.Row="0"
                   Grid.Column="0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServerPortTapped"
                                  CommandParameter="2|CodeObject1" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Значение -->
                <Label x:Name="CodeObject1ValueLabel"
                   Text="empty"
                   FontSize="18"
                   TextColor="#A9A9B0"
                   FontAttributes="Bold"
                   VerticalOptions="Start"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="End"
                   Margin="0,18,10,0"
                   Grid.Row="0"
                   Grid.Column="1"
                   MaxLines="1"
                   LineBreakMode="TailTruncation" />

                <!-- Entry -->
                <Entry x:Name="CodeObject1Entry"
                   Placeholder="Введите значение"
                   Keyboard="Numeric"
                   MaxLength="5"
                   TextChanged="CodeObject1_TextChanged"
                   FontSize="18"
                   TextColor="White"
                   BackgroundColor="#232323"
                   Margin="10,0,10,0"
                   VerticalOptions="Center"
                   HorizontalOptions="Fill"
                   HeightRequest="44"
                   Grid.Row="1"
                   Grid.Column="0"
                   Grid.ColumnSpan="2" />

                <!-- Кнопка -->
                <Button Text="⏺️"
                    BackgroundColor="#313131"
                    TextColor="#000000"
                    FontSize="32"
                    CornerRadius="10"
                    HeightRequest="44"
                    WidthRequest="44"
                    Padding="0"
                    Margin="0,0,10,0"
                    BorderWidth="0"
                    Clicked="CodeObject1"
                    HorizontalOptions="End"
                    Grid.Row="1"
                    Grid.Column="2" />

            
                <!-- ===== AccessPoint1 (Row 3-4) ===== -->

                <!-- Заголовок -->
                <Label x:Name="AccessPoint1tLabel"
                   Text="Точка доступу"
                   FontSize="18"
                   FontAttributes="Bold"
                   TextColor="White"
                   VerticalOptions="Start"
                   HorizontalOptions="Start"
                   Margin="12,0,8,0"
                   Grid.Row="3"
                   Grid.Column="0">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnServerPortTapped"
                                  CommandParameter="2|AccessPoint1" />
                    </Label.GestureRecognizers>
                </Label>

                <!-- Значение -->
                <Label x:Name="AccessPoint1ValueLabel"
                   Text="empty"
                   FontSize="18"
                   TextColor="#A9A9B0"
                   FontAttributes="Bold"
                   VerticalOptions="Start"
                   HorizontalOptions="Fill"
                   HorizontalTextAlignment="End"
                   Margin="0,0,10,0"
                   Grid.Row="3"
                   Grid.Column="1"
                   MaxLines="1"
                   LineBreakMode="TailTruncation" />

                <!-- Entry -->
                <Entry x:Name="AccessPoint1Entry"
                   Placeholder="Введите значение"
                   Keyboard="Text"
                   MaxLength="8"
                   TextChanged="AccessPoint1Entry_TextChanged"
