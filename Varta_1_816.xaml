<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="skb_home.Varta_1_816"
             Title="Varta 1/816"       
             BackgroundColor="#000000">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🔄" Order="Primary" Priority="0" Clicked="OnRefreshClicked"/>
        <ToolbarItem Text="⚙" Order="Primary" Priority="1" Clicked="OnSettingsClicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView Orientation="Vertical" VerticalScrollBarVisibility="Default">
        <VerticalStackLayout HorizontalOptions="Center" 
                             Spacing="12" 
                             Padding="10,8,10,20">

            <!-- Заголовок страницы -->
            <Label Text="Струм шлейфів"
                   FontSize="22"
                   FontAttributes="Bold"
                   TextColor="#FFFFFF"
                   HorizontalOptions="Center"
                   HorizontalTextAlignment="Center">
                <Label.Shadow>
                    <Shadow Brush="Black" Radius="10" Offset="3,3" Opacity="0.7"/>
                </Label.Shadow>
            </Label>

            <!-- Легенда состояний -->
            <HorizontalStackLayout HorizontalOptions="Center" 
                                   Spacing="18" 
                                   Margin="0,0,0,4">

                <!-- Норма -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <BoxView Color="Green"
                             WidthRequest="24" 
                             HeightRequest="14"
                             CornerRadius="3"
                             VerticalOptions="Center" />
                    <Label Text="норма"
                           FontSize="13"
                           TextColor="White"
                           VerticalOptions="Center"
                           FontAttributes="Bold" />
                </HorizontalStackLayout>

                <!-- Обрив -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <BoxView Color="Blue"
                             WidthRequest="24" 
                             HeightRequest="14"
                             CornerRadius="3"
                             VerticalOptions="Center" />
                    <Label Text="обрив"
                           FontSize="13"
                           TextColor="White"
                           VerticalOptions="Center"
                           FontAttributes="Bold"/>
                </HorizontalStackLayout>

                <!-- К.З. -->
                <HorizontalStackLayout Spacing="6" VerticalOptions="Center">
                    <BoxView Color="#8B0000"
                             WidthRequest="24" 
                             HeightRequest="14"
                             CornerRadius="3"
                             VerticalOptions="Center" />
                    <Label Text="к.з."
                           FontSize="13"
                           TextColor="White"
                           VerticalOptions="Center"
                           FontAttributes="Bold"/>
                </HorizontalStackLayout>

            </HorizontalStackLayout>

            <!-- 1. АДАПТИВНЫЙ БЛОК ГИСТОГРАММЫ (заменил жесткий Grid 340x270) -->
            <Border WidthRequest="{Binding HistWidth}"
                    HeightRequest="{Binding HistHeight}"
                    HorizontalOptions="Center"
                    BackgroundColor="#CAE9FBF9"
                    StrokeThickness="1"
                    Stroke="#33FFFFFF"
                    StrokeShape="RoundRectangle 12"
                    Padding="6,8,8,6">

                <!-- GraphicsView теперь полностью заполняет отведенную область -->
                <GraphicsView x:Name="HistCanvas"
                              HorizontalOptions="Fill"
                              VerticalOptions="Fill"
                              BackgroundColor="Transparent" />
            </Border>

            <!-- 2. СТРОКА СВИТЧА ТЕРМИНАЛА (адаптивная ширина под график) -->
            <Grid WidthRequest="{Binding ContentCardWidth}"
                  HorizontalOptions="Center"
                  ColumnDefinitions="*, Auto" 
                  Padding="8,4"
                  VerticalOptions="Center">

                <Label Grid.Column="0"
                       Text="Включити термінал"
                       TextColor="#FFFFFF"
                       FontSize="18"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Start">
                    <Label.Shadow>
                        <Shadow Brush="Black" Radius="6" Offset="2,2" Opacity="0.6"/>
                    </Label.Shadow>
                </Label>

                <Switch Grid.Column="1"
                        x:Name="TerminalSwitch"
                        OnColor="#1046B0"
                        ThumbColor="White"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        Toggled="OnTerminalToggled"/>
            </Grid>

            <!-- 3. ОКНО ТЕРМИНАЛА (адаптивные ширина и высота) -->
            <Border x:Name="TerminalBorder"
                    IsVisible="False"
                    Stroke="#0B0101"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#4A9192"
                    Padding="10"
                    WidthRequest="{Binding ContentCardWidth}"
                    HeightRequest="{Binding TerminalHeight}"
                    HorizontalOptions="Center">

                <Grid RowDefinitions="Auto, *">
                    <!-- Заголовок и кнопка очистки -->
                    <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Margin="0,0,0,8">
                        <Label Grid.Column="0"
                               Text="🖥️ Термінал"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#000000"
                               VerticalOptions="Center"/>

                        <Button Grid.Column="1"
                                Text="🗑️ Очистити"
                                BackgroundColor="#FFFFFF"
                                TextColor="#000000"
                                FontAttributes="Bold"
                                FontSize="13"
                                Padding="8,4"
                                CornerRadius="5"
                                Clicked="OnClearTerminalClicked"/>
                    </Grid>

                    <!-- Окно лога сообщений -->
                    <ScrollView Grid.Row="1" x:Name="scrollView" VerticalOptions="Fill">
                        <Label x:Name="label4"
                               Text="Empty text to receive data"
                               FontAttributes="Bold"
                               FontSize="15"
                               TextColor="Black"
                               LineBreakMode="WordWrap"
                               VerticalTextAlignment="Start"
                               HorizontalTextAlignment="Start"/>
                    </ScrollView>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>