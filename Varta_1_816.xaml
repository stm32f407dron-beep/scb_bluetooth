            <Grid ColumnDefinitions="Auto,*,Auto" ColumnSpacing="10" HeightRequest="50" WidthRequest="320">
                <Label Grid.Column="0"
                  Margin="4,15,0,0"          
               Text="Включити термінал"
               TextColor="#FFFFFF"
               FontSize="22"
               FontAttributes="Bold"
               VerticalOptions="Center"
               HorizontalOptions="Start">
                    <Label.Shadow>
                        <Shadow Brush="Black" Radius="8" Offset="2,2" Opacity="0.6"/>
                    </Label.Shadow>
                </Label>
                <Switch Grid.Column="1"
                x:Name="TerminalSwitch"
                OnColor="#1046B0"
                ThumbColor="White"
                Margin="40,15,0,0"
                VerticalOptions="Center"
                HorizontalOptions="Start"
                Toggled="OnTerminalToggled"/>
            </Grid>

            <Border x:Name="TerminalBorder"
              IsVisible="False"
              Stroke="#0B0101"
              StrokeThickness="2"
              StrokeShape="RoundRectangle 10"
              BackgroundColor="#4A9192"
              Padding="10"
              Margin="0,15,0,0"      
              HeightRequest="510"
              WidthRequest="345">
                <Grid RowDefinitions="Auto,*">
                    <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,5">
                        <Label Text="🖥️ Термінал"
                   FontAttributes="Bold"
                   FontSize="16"
                   TextColor="#000000"
                   VerticalOptions="Center"/>
                        <Button Text="🗑️ Очистити"
                    BackgroundColor="#FFFFFF"
                    TextColor="#000000"
                    FontAttributes="Bold"
                    FontSize="14"
                    Padding="5,2"
                    CornerRadius="5"
                    Clicked="OnClearTerminalClicked"/>
                    </HorizontalStackLayout>
                    <ScrollView Grid.Row="1" x:Name="scrollView" VerticalOptions="Fill">
                        <Label x:Name="label4"
                   Text="Empty text to receive data"
                   FontAttributes="Bold"
                   FontSize="18"
                   TextColor="Black"
                   LineBreakMode="WordWrap"
                   VerticalTextAlignment="Start"
                   HorizontalTextAlignment="Start"/>
                    </ScrollView>
                </Grid>
            </Border>
        </StackLayout>
    </ScrollView>
