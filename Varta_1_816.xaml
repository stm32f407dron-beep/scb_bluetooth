<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="skb_home.Varta_1_816"
             Title="Varta 1/816"       
             BackgroundColor="#000000"
             Padding="-1">
    <ContentPage.ToolbarItems>
        <ToolbarItem Text="🔄" Order="Primary" Priority="0" Clicked="OnRefreshClicked"/>
        <ToolbarItem Text="⚙" Order="Primary" Priority="1" Clicked="OnSettingsClicked"/>
    </ContentPage.ToolbarItems>
    <ScrollView Orientation="Vertical" VerticalScrollBarVisibility="Default">
        <StackLayout HorizontalOptions="Center" Spacing="2" Padding="0,4">

            <!-- Заголовок -->
            <Label Text="Струм шлейфів"
                Margin="0,5,0,0"   
             FontSize="24"
             FontAttributes="Bold"
             TextColor="#FFFFFF"
             HorizontalTextAlignment="Center"
             VerticalTextAlignment="Center"
                 
                   >
                <Label.Shadow>
                    <Shadow Brush="Black" Radius="15" Offset="5,5" Opacity="0.7"/>
                </Label.Shadow>
            </Label>


            <!-- Легенда состояний (овалы с подписями) -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="22" Margin="0,6,0,4">
                <!-- Норма -->
                <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                    <BoxView Color="Green"
                 WidthRequest="28" HeightRequest="14"
                 CornerRadius="3"
                 VerticalOptions="Center"
                    BackgroundColor ="Black"                  
                             />
                    <Label Text="норма"
               FontSize="14"
               TextColor="White"
               VerticalOptions="Center"
               
                 FontAttributes="Bold"      
                           />
                </StackLayout>
                <!-- Обрив -->
                <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                    <BoxView Color="Blue"
                 WidthRequest="28" HeightRequest="14"
                 CornerRadius="3"
                 VerticalOptions="Center"
                   BackgroundColor ="Black"                   
                             />
                    <Label Text="обрив"
               FontSize="14"
               TextColor="White"
               VerticalOptions="Center"
               FontAttributes="Bold"/>
                </StackLayout>
                <!-- К.З. -->
                <StackLayout Orientation="Horizontal" Spacing="5" VerticalOptions="Center">
                    <BoxView Color="#6e1717"
                 WidthRequest="28" HeightRequest="14"
                 CornerRadius="5"
                 VerticalOptions="Center"
                  BackgroundColor ="Black"           
                             />
                    <Label Text="к.з."
               FontSize="14"
               TextColor="White"
               VerticalOptions="Center"
               FontAttributes="Bold"/>
                </StackLayout>
            </HorizontalStackLayout>



            <!-- Гистограмма с идеальной разметкой -->
            <Grid WidthRequest="340" HeightRequest="270"
            RowDefinitions="20,246,30,*"
            ColumnDefinitions="25,275,25">

                 <!--Белый скруглённый фон--> 
                <Border Grid.Row="1" Grid.Column="1"
                BackgroundColor="#CAE9FBF9"
                Stroke="{x:Null}"
                StrokeShape="RoundRectangle 12"
                HeightRequest="246"
                WidthRequest="300"
                       
                        />

                 <!--График--> 
                <GraphicsView x:Name="HistCanvas"
                      Grid.Row="1"
                      Grid.Column="1"
                      WidthRequest="275"
                      HeightRequest="246"
                      BackgroundColor="Transparent"
                             
                              />
            </Grid>


