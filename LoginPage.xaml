<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="skb_home.LoginPage"
             Title="Авторизація"
             BackgroundColor="#1a1a1a">

    <VerticalStackLayout Spacing="15" Padding="30" VerticalOptions="Center">
        <Label Text="Вхід у систему" 
               FontSize="22" 
               TextColor="White" 
               HorizontalOptions="Center" 
               FontAttributes="Bold"/>

        <Entry Placeholder="Логін" TextColor="White" />
        <Entry Placeholder="Пароль" IsPassword="True" TextColor="White" />

        <Button Text="Увійти" BackgroundColor="#0c69c6" Clicked="OnLoginClicked"/>
        <Button Text="Скасувати" BackgroundColor="Transparent" TextColor="Gray" Clicked="OnCancelClicked"/>
    </VerticalStackLayout>
</ContentPage>