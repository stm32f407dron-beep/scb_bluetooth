                    <Label Text="Вас вітає"
                   FontSize="20"
                   HorizontalOptions="Center"
                   TextColor="White"
                   FontAttributes="Bold"
                   Margin="0,70,0,0" />

                 <Label Text="СКБ ЕЛЕКТРОНМАШ!"
                   FontSize="24"
                   HorizontalOptions="Center"
                   TextColor="White"
                   FontAttributes="Bold"
                   Margin="0,20,0,0" />

              
                <Image x:Name="rotatingImage"
                       Source="scb.png"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HeightRequest="92"
                       WidthRequest="81"
                       Margin="0,19,0,0" />





            </Grid>-->


            <Grid HeightRequest="250"
      VerticalOptions="Start"
      HorizontalOptions="Center"
      Margin="0,4,0,10"
      RowSpacing="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- верхний текст -->
                    <RowDefinition Height="*"/>
                    <!-- зона для значка -->
                    <RowDefinition Height="Auto"/>
                    <!-- нижний текст (СКБ...) -->
                </Grid.RowDefinitions>

                <!-- Фон на весь Grid -->
                <Image Source="fon.jpg"
           Aspect="AspectFill"
           WidthRequest="350"
           HeightRequest="255"
           HorizontalOptions="Center"
           VerticalOptions="Fill"
           Grid.Row="0"
           Grid.RowSpan="3"/>

                <!-- ВЕРХ: "Вас вітає" -->
                <Label Text="Вас вітає"
           Grid.Row="0"
           FontSize="24"
           HorizontalOptions="Center"
           TextColor="White"
           FontAttributes="Bold"
           Margin="0,69,0,0"/>

                <!-- ЦЕНТР: вращающийся значок -->
                <Image x:Name="rotatingImage"
           Grid.Row="1"
           Source="scb.png"
           HorizontalOptions="Center"
           VerticalOptions="Center"
           HeightRequest="92"
           WidthRequest="81"/>

                <!-- НИЗ: "СКБ ЕЛЕКТРОНМАШ!" (будет ниже значка, но на фоне картинки) -->
                <Label Text="СКБ ЕЛЕКТРОНМАШ!"
           Grid.Row="2"
           FontSize="24"
           HorizontalOptions="Center"
           TextColor="White"
           FontAttributes="Bold"
           Margin="0,25,0,14"/>
            </Grid>









            <Label Text="www.chelmash.com.ua"
               FontSize="16"
                HorizontalOptions="Center"
                TextColor="Blue"
                 FontAttributes="Bold"
                  Margin="0,10,0,0">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLinkTapped" NumberOfTapsRequired="1" />
                </Label.GestureRecognizers>
            </Label>




            <!-- Горизонтальная прокрутка -->
            <CarouselView ItemsSource="{Binding CarouselItems}" IndicatorView="indicator">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="10" HorizontalOptions="Center" VerticalOptions="Center">

                            <Label Text="{Binding Title}" 
                       FontSize="20"
                        TextColor="White"
                       FontAttributes="Bold"
                       HorizontalOptions="Center"
                       Margin="0,10" />

                            <!-- Показываем либо рисунок, либо снежинку -->
                            <Border Stroke="#0B0101" 
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 25" 
                        BackgroundColor="#7a154d85"
                      
                        Padding="5"
                        Margin="5"
                        HeightRequest="220"
                        WidthRequest="220">

                                <Image Source="{Binding ImageToDisplay}" 
                           HorizontalOptions="Center"
                           VerticalOptions="Center"
                           HeightRequest="200"
                           WidthRequest="200">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer 
                                Command="{Binding Path=BindingContext.ItemSelectedCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                CommandParameter="{Binding}" />
                                    </Image.GestureRecognizers>
                                </Image>

                            </Border>



                        </VerticalStackLayout>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>


            <!-- Индикатор -->
            <IndicatorView x:Name="indicator" IndicatorColor="Gray" SelectedIndicatorColor="Blue" 
               HorizontalOptions="Center" Margin="0,10,0,0" />

        </VerticalStackLayout>

       
    </AbsoluteLayout>


    


</ContentPage>


