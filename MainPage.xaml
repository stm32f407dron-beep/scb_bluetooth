<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"           
             x:Class="skb_home.MainPage"
             BackgroundColor="#1a1a1a"
             Shell.NavBarIsVisible="false">

    <!-- Корневой AbsoluteLayout, чтобы меню позиционировалось точно так, как было задуманно в PopupMenu -->
    <AbsoluteLayout x:Name="RootLayout">

        <!-- Вся страница (Grid со скроллом) занимает 100% ширины и высоты -->
        <Grid AbsoluteLayout.LayoutBounds="0, 0, 1, 1"
              AbsoluteLayout.LayoutFlags="All"
              RowDefinitions="50, *">

            <!-- 1. Верхняя Панель -->
            <Grid Grid.Row="0"
                  BackgroundColor="#1f1f1f" 
                  Padding="10,0"
                  ColumnDefinitions="*, Auto, Auto">

                <Label Text=""
                       FontSize="16" 
                       TextColor="White"
                       VerticalOptions="Center"
                       HorizontalOptions="Start"
                       FontAttributes="Bold" />

                <Button Grid.Column="1"
                        Text="☰" 
                        FontSize="24" 
                        TextColor="#0c69c6"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        WidthRequest="40"
                        Clicked="OnMenuClicked"
                        HorizontalOptions="End"
                        VerticalOptions="Center" />

                <Button Grid.Column="2"
                        Text="⌂" 
                        FontSize="26" 
                        TextColor="#0c69c6"
                        FontAttributes="Bold"
                        BackgroundColor="Transparent"
                        WidthRequest="40"
                        HeightRequest="40"
                        Padding="0"
                        Clicked="OnHashClicked"
                        HorizontalOptions="End"
                        VerticalOptions="Center"
                        Margin="5,0,5,0" /> 
            </Grid>

            <!-- 2. Основной контент со скроллом -->
            <ScrollView Grid.Row="1">
                <VerticalStackLayout Padding="15,5,15,15" Spacing="8">

                    <!-- Верхний баннер -->
                    <Grid HeightRequest="{Binding TopGridHeight}"
                          HorizontalOptions="Fill"
                          Margin="0,0,0,10"
                          RowSpacing="0">

                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto"/>
                            <RowDefinition Height="*"/>
                            <RowDefinition Height="Auto"/>
                        </Grid.RowDefinitions>

                        <Image Source="fon.jpg"
                               Aspect="AspectFill"
                               Grid.RowSpan="3"/>

                        <Label Text="Вас вітає"
                               Grid.Row="0"
                               FontSize="21"
                               HorizontalOptions="Center"
                               TextColor="White"
                               FontAttributes="Bold"
                               Margin="0,45,0,5"/>

                        <Image x:Name="rotatingImage"
                               Grid.Row="1"
                               Source="scb.png"
                               HorizontalOptions="Center"
                               VerticalOptions="Center"
                               HeightRequest="80"
                               WidthRequest="70"/>

                        <Label Text="СКБ ЕЛЕКТРОНМАШ!"
                               Grid.Row="2"
                               FontSize="21"
                               HorizontalOptions="Center"
                               TextColor="White"
                               FontAttributes="Bold"
                               Margin="0,5,0,12"/>
                    </Grid>

                    <!-- Сайт -->
                    <Label Text="www.chelmash.com.ua"
                           FontSize="15"
                           HorizontalOptions="Center"
                           TextColor="#B0B0B0"
                           FontAttributes="Bold"
                           Margin="0,0,0,8">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnLinkTapped" />
                        </Label.GestureRecognizers>
                    </Label>

                    <!-- Карусель -->
                    <CarouselView ItemsSource="{Binding CarouselItems}" 
                                  IndicatorView="indicator">
                        <CarouselView.ItemTemplate>
                            <DataTemplate>
                                <VerticalStackLayout Spacing="8" 
                                                     HorizontalOptions="Center" 
                                                     VerticalOptions="Center">

                                    <Label Text="{Binding Title}" 
                                           FontSize="18"
                                           TextColor="White"
                                           FontAttributes="Bold"
                                           HorizontalOptions="Center"
                                           Margin="0,4" />

                                    <Border Stroke="#0F0101" 
                                            StrokeThickness="2"
                                            StrokeShape="RoundRectangle 25" 
                                            BackgroundColor="#1C276D"
                                            Padding="5"
                                            Margin="5"
                                            HeightRequest="{Binding Path=BindingContext.CardSize, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                            WidthRequest="{Binding Path=BindingContext.CardSize, Source={RelativeSource AncestorType={x:Type ContentPage}}}">

                                        <Image Source="{Binding ImageToDisplay}" 
                                               HorizontalOptions="Fill"
                                               VerticalOptions="Fill"
                                               Aspect="AspectFit">
                                            <Image.GestureRecognizers>
                                                <TapGestureRecognizer 
                                                    Command="{Binding Path=BindingContext.ItemSelectedCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                                    CommandParameter="{Binding}" />
                                            </Image.GestureRecognizers>
                                        </Image>
                                    </Border>
                                </VerticalStackLayout>
                            </DataTemplate>
                        </CarouselView.ItemTemplate>
                    </CarouselView>

                    <!-- Индикатор -->
                    <IndicatorView x:Name="indicator" 
                                   IndicatorColor="White" 
                                   SelectedIndicatorColor="#181869" 
                                   HorizontalOptions="Center" 
                                   Margin="0,8,0,0" />

                </VerticalStackLayout>
            </ScrollView>

        </Grid>
    </AbsoluteLayout>
</ContentPage>
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
    
