<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"           
             x:Class="skb_home.MainPage"
              BackgroundColor="#ad040d1a"
             Shell.NavBarIsVisible="false">


    <!--xmlns:skia="clr-namespace:SkiaSharp.Views.Maui.Controls;assembly=SkiaSharp.Views.Maui.Controls"-->
    

        <!-- Обертка для прокрутки экрана -->
    <AbsoluteLayout>
        <!-- Верхняя Панель -->
        <Grid AbsoluteLayout.LayoutBounds="0,0,1,0.08" 
            AbsoluteLayout.LayoutFlags="All"
            HeightRequest="50"
          
            BackgroundColor="#1f1f1f" Padding="0,1">
          
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Заголовок -->
            <Label Text=""
                FontSize="16" 
                TextColor="White"
                VerticalOptions="Center"
                HorizontalOptions="Start"
                 Margin="10,0,0,0"
                 FontAttributes="Bold" />

                <!-- Кнопка для вызова меню -->
                  <Button Grid.Column="1"
                   Text="☰" 
                    FontSize="24" 
                    TextColor="#0c69c6"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    WidthRequest="30"
                  
                    Clicked="OnMenuClicked"
                    HorizontalOptions="End"
                    VerticalOptions="Center" />

                   
            <Grid Grid.Column="2"
                    WidthRequest="20" 
                      HeightRequest="20" 
                   HorizontalOptions="End" 
                   VerticalOptions="Center"
                    Margin="0,0,7,0"    >
                <ImageButton Source="home3.png" 
                 BackgroundColor="#0c69c6"
                 Aspect="Center" 
                    Clicked="OnHashClicked" />
            </Grid>


        </Grid>

        <!-- Основной контент -->
        <VerticalStackLayout AbsoluteLayout.LayoutBounds="0,0.1,1,0.75"
                              AbsoluteLayout.LayoutFlags="All"
                              Padding="35">
         

            <!--<Grid HeightRequest="250"  
                VerticalOptions="Start"
                HorizontalOptions="Center"
                 Margin="0,4,0,10">
            

                <Image Source="fon.jpg" 
                   Aspect="AspectFill" 
                    WidthRequest="350"
                    
                    HeightRequest="255"
                   
                    HorizontalOptions="Center"
                   
