<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"           
             x:Class="skb_home.MainPage"
             BackgroundColor="#ad040d1a"
             Shell.NavBarIsVisible="false">

    <AbsoluteLayout>
        <!-- Верхняя Панель (8%) -->
        <Grid AbsoluteLayout.LayoutBounds="0,0,1,0.075" 
              AbsoluteLayout.LayoutFlags="All"
              BackgroundColor="#1f1f1f" 
              Padding="0,1">

            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Label Text=""
                   FontSize="16" 
                   TextColor="White"
                   VerticalOptions="Center"
                   HorizontalOptions="Start"
                   Margin="10,0,0,0"
                   FontAttributes="Bold" />

            <Button Grid.Column="1"
                    Text="☰" 
                    FontSize="24" 
                    TextColor="#0c69c6"
                    FontAttributes="Bold"
                    BackgroundColor="Transparent"
                    WidthRequest="30"
                    Clicked="OnMenuClicked"
                    HorizontalOptions="End"
                    VerticalOptions="Center" />

            <Grid Grid.Column="2"
                  WidthRequest="20" 
                  HeightRequest="20" 
                  HorizontalOptions="End" 
                  VerticalOptions="Center"
                  Margin="0,0,7,0">
                <ImageButton Source="home3.png" 
                             BackgroundColor="#0c69c6"
                             Aspect="Center" 
                             Clicked="OnHashClicked" />
            </Grid>
        </Grid>

        <!-- Основной контент (75%) -->
        <VerticalStackLayout AbsoluteLayout.LayoutBounds="0,1.5,1,0.9"
                             AbsoluteLayout.LayoutFlags="All"
                             Padding="15,0,15,15">

            <!-- Верхний Grid (логотип) -->
            <Grid HeightRequest="{Binding TopGridHeight}"
                  VerticalOptions="Start"
                  HorizontalOptions="Center"
                  Margin="0,0,0,15"
                  RowSpacing="0">

                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Фон -->
                <Image Source="fon.jpg"
                       Aspect="AspectFill"
                       HorizontalOptions="Center"
                       VerticalOptions="Fill"
                       Grid.Row="0"
                       Grid.RowSpan="3"/>

                <!-- ВЕРХ: "Вас вітає" -->
                <Label Text="Вас вітає"
                       Grid.Row="0"
                       FontSize="24"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       Margin="0,20,0,0"/>

                <!-- ЦЕНТР: вращающийся значок (фиксированный размер) -->
                <Image x:Name="rotatingImage"
                       Grid.Row="1"
                       Source="scb.png"
                       HorizontalOptions="Center"
                       VerticalOptions="Center"
                       HeightRequest="92"
                       WidthRequest="81"
                       Margin="0,35,0,0"
                       />

                <!-- НИЗ: "СКБ ЕЛЕКТРОНМАШ!" -->
                <Label Text="СКБ ЕЛЕКТРОНМАШ!"
                       Grid.Row="2"
                       FontSize="24"
                       HorizontalOptions="Center"
                       TextColor="White"
                       FontAttributes="Bold"
                       Margin="0,15,0,10"/>
            </Grid>

            <!-- Сайт -->
            <Label Text="www.chelmash.com.ua"
                   FontSize="16"
                   HorizontalOptions="Center"
                   TextColor="Blue"
                   FontAttributes="Bold"
                   Margin="0,5,0,15">
                <Label.GestureRecognizers>
                    <TapGestureRecognizer Tapped="OnLinkTapped" NumberOfTapsRequired="1" />
                </Label.GestureRecognizers>
            </Label>

            <!-- CarouselView с адаптивными карточками -->
            <CarouselView ItemsSource="{Binding CarouselItems}" 
                          IndicatorView="indicator">
                <CarouselView.ItemTemplate>
                    <DataTemplate>
                        <VerticalStackLayout Spacing="10" 
                                           HorizontalOptions="Center" 
                                           VerticalOptions="Center">

                            <Label Text="{Binding Title}" 
                                   FontSize="20"
                                   TextColor="White"
                                   FontAttributes="Bold"
                                   HorizontalOptions="Center"
                                   Margin="0,10" />

                            <!-- Адаптивная карточка -->
                            <Border Stroke="#0F0101" 
                                    StrokeThickness="2"
                                    StrokeShape="RoundRectangle 25" 
                                    BackgroundColor="#B31C1C38"
                                    Padding="5"
                                    Margin="5"
                                    HeightRequest="{Binding Path=BindingContext.CardSize, Source={RelativeSource AncestorType={x:Type ContentPage}}}"
                                    WidthRequest="{Binding Path=BindingContext.CardSize, Source={RelativeSource AncestorType={x:Type ContentPage}}}">

                                <Image Source="{Binding ImageToDisplay}" 
                                       HorizontalOptions="Center"
                                       VerticalOptions="Center"
                                       HeightRequest="200"
                                       WidthRequest="200">
                                    <Image.GestureRecognizers>
                                        <TapGestureRecognizer 
                                            Command="{Binding Path=BindingContext.ItemSelectedCommand, Source={RelativeSource AncestorType={x:Type ContentPage}}}" 
                                            CommandParameter="{Binding}" />
                                    </Image.GestureRecognizers>
                                </Image>

                            </Border>

                        </VerticalStackLayout>
                    </DataTemplate>
                </CarouselView.ItemTemplate>
            </CarouselView>

            <!-- Индикатор -->
            <IndicatorView x:Name="indicator" 
                          IndicatorColor="Gray" 
                          SelectedIndicatorColor="Blue" 
                          HorizontalOptions="Center" 
                          Margin="0,10,0,0" />

        </VerticalStackLayout>

    </AbsoluteLayout>

</ContentPage>
