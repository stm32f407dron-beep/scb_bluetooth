<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="skb_home.Varta_832"
             Title="Таблиця параметрів і станів шлейфів"
             BackgroundColor="#ECE9D8">

    <ContentPage.ToolbarItems>
        <ToolbarItem Text="⚙" Order="Primary" Priority="1" Clicked="OnSettingsClicked"/>
    </ContentPage.ToolbarItems>

    <ScrollView>
        <VerticalStackLayout Padding="4" Spacing="6" HorizontalOptions="Center" MaximumWidthRequest="720">

            <!-- 1. ВЕРХНЯЯ ПАНЕЛЬ -->
            <Border Stroke="#7F9DB9" StrokeThickness="1" BackgroundColor="#EBF2FA" Padding="6,4">
                <Grid ColumnDefinitions="Auto,Auto,Auto,*" ColumnSpacing="6" VerticalOptions="Center">
                    <Button Grid.Column="0"
                            Text="❌"
                            FontSize="13"
                            WidthRequest="34"
                            HeightRequest="30"
                            Padding="0"
                            BackgroundColor="#DDE7F5"
                            BorderColor="#7F9DB9"
                            BorderWidth="1"
                            CornerRadius="3"
                            Clicked="OnAddressConfigClicked"/>

                    <Button Grid.Column="1"
                            Text="💾"
                            FontSize="13"
                            WidthRequest="34"
                            HeightRequest="30"
                            Padding="0"
                            BackgroundColor="#DDE7F5"
                            BorderColor="#7F9DB9"
                            BorderWidth="1"
                            CornerRadius="3"
                            Clicked="OnSaveClicked"/>

                    <Label Grid.Column="2"
                           Text="Адреса приладу"
                           TextColor="#000080"
                           FontAttributes="Bold"
                           FontSize="13"
                           VerticalOptions="Center"
                           Margin="4,0,0,0"/>

                    <!--<Border Grid.Column="3"
                            Stroke="#7F9DB9"
                            StrokeThickness="1"
                            BackgroundColor="White"
                            HeightRequest="30"
                            Padding="4,0"
                            VerticalOptions="Center">
                        <Picker x:Name="DeviceAddressPicker"
                                TextColor="#000000"
                                FontSize="13"
                                VerticalOptions="Center">
                            <Picker.ItemsSource>
                                <x:Array Type="{x:Type x:String}">
                                    <x:String>1 - ВАРТА832 1</x:String>
                                    <x:String>2 - ВАРТА832 2</x:String>
                                    <x:String>3 - ВАРТА832 3</x:String>
                                </x:Array>
                            </Picker.ItemsSource>
                        </Picker>
                    </Border>-->

                    <!-- Выбор адреса (Picker) -->
                    <Border Grid.Column="3"
                        Stroke="#7F9DB9"
                        StrokeThickness="1"
                        BackgroundColor="White"
                        HeightRequest="38"
                        Padding="4,0"
                        VerticalOptions="Center">
                                    <Picker x:Name="DeviceAddressPicker"
                            TextColor="#000000"
                            FontSize="13"
                            FontAttributes="Bold"               
                            Margin="0"
                            VerticalOptions="Fill"
                            HorizontalOptions="Fill">
                                        <Picker.ItemsSource>
                                            <x:Array Type="{x:Type x:String}">
                                                <x:String>1 - ВАРТА832 1</x:String>
                                                <x:String>2 - ВАРТА832 2</x:String>
                                                <x:String>3 - ВАРТА832 3</x:String>
                                            </x:Array>
                                        </Picker.ItemsSource>
                                    </Picker>
                    </Border>       










                </Grid>
            </Border>

            <!-- 2. ВКЛАДКИ СТРАНИЦ -->
            <ScrollView Orientation="Horizontal" HorizontalScrollBarVisibility="Never">
                <HorizontalStackLayout Spacing="2">
                    <Button Text="БВШ" FontAttributes="Bold" FontSize="11" BackgroundColor="#FFFFFF" TextColor="#000000" BorderColor="#7F9DB9" BorderWidth="1" CornerRadius="2" HeightRequest="26" Padding="8,0"/>
                    <Button Text="БКН" FontSize="11" BackgroundColor="#E0DFD8" TextColor="#444" BorderColor="#A0A0A0" BorderWidth="1" CornerRadius="2" HeightRequest="26" Padding="8,0" Clicked="OnStubTabClicked"/>
                    <Button Text="BVK" FontSize="11" BackgroundColor="#E0DFD8" TextColor="#444" BorderColor="#A0A0A0" BorderWidth="1" CornerRadius="2" HeightRequest="26" Padding="8,0" Clicked="OnStubTabClicked"/>
                    <Button Text="БВК-8" FontSize="11" BackgroundColor="#E0DFD8" TextColor="#444" BorderColor="#A0A0A0" BorderWidth="1" CornerRadius="2" HeightRequest="26" Padding="8,0" Clicked="OnStubTabClicked"/>
                    <Button Text="Реле" FontSize="11" BackgroundColor="#E0DFD8" TextColor="#444" BorderColor="#A0A0A0" BorderWidth="1" CornerRadius="2" HeightRequest="26" Padding="8,0" Clicked="OnStubTabClicked"/>
                    <Button Text="Віртуальні ключі" FontSize="11" BackgroundColor="#E0DFD8" TextColor="#444" BorderColor="#A0A0A0" BorderWidth="1" CornerRadius="2" HeightRequest="26" Padding="8,0" Clicked="OnStubTabClicked"/>
                    <Button Text="CIE" FontSize="11" BackgroundColor="#E0DFD8" TextColor="#444" BorderColor="#A0A0A0" BorderWidth="1" CornerRadius="2" HeightRequest="26" Padding="8,0" Clicked="OnStubTabClicked"/>
                    <Button Text="Configuration of loops from a file" FontSize="11" BackgroundColor="#E0DFD8" TextColor="#444" BorderColor="#A0A0A0" BorderWidth="1" CornerRadius="2" HeightRequest="26" Padding="8,0" Clicked="OnStubTabClicked"/>
                </HorizontalStackLayout>
            </ScrollView>

            <!-- 3. ТАБЛИЦА БВШ НА 8 СТРОК -->
            <Border Stroke="#7F9DB9" StrokeThickness="1" BackgroundColor="White">
                <ScrollView Orientation="Horizontal">
                    <VerticalStackLayout WidthRequest="680">

                        <!-- Шапка таблицы -->
                        <Grid ColumnDefinitions="32,46,46,180,110,44,110,44" BackgroundColor="#DDE7F5" HeightRequest="26">
                            <Label Grid.Column="0" Text="№" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                            <Label Grid.Column="1" Text="Адреса" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                            <Label Grid.Column="2" Text="Шлейф" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                            <Label Grid.Column="3" Text="Ідентифікатор" FontAttributes="Bold" VerticalTextAlignment="Center" Margin="4,0" FontSize="11" TextColor="Black"/>
                            <Label Grid.Column="4" Text="Тип ШС" FontAttributes="Bold" VerticalTextAlignment="Center" Margin="4,0" FontSize="11" TextColor="Black"/>
                            <Label Grid.Column="5" Text="Код" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                            <Label Grid.Column="6" Text="Стан" FontAttributes="Bold" VerticalTextAlignment="Center" Margin="4,0" FontSize="11" TextColor="Black"/>
                            <Label Grid.Column="7" Text="Код" FontAttributes="Bold" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                        </Grid>

                        <BoxView HeightRequest="1" Color="#7F9DB9"/>

                        <!-- 8 строк текущего блока -->
                        <CollectionView x:Name="LoopsCollectionView">
                            <CollectionView.ItemTemplate>
                                <DataTemplate>
                                    <Grid ColumnDefinitions="32,46,46,180,110,44,110,44" HeightRequest="24" BackgroundColor="{Binding RowBackgroundColor}">
                                        <Label Grid.Column="0" Text="{Binding Number}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                                        <Label Grid.Column="1" Text="{Binding Address}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                                        <Label Grid.Column="2" Text="{Binding LoopNumber}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                                        <Label Grid.Column="3" Text="{Binding Identifier}" LineBreakMode="TailTruncation" VerticalTextAlignment="Center" Margin="4,0" FontSize="11" TextColor="Black"/>
                                        <Label Grid.Column="4" Text="{Binding TypeText}" VerticalTextAlignment="Center" Margin="4,0" FontSize="11" TextColor="Black"/>
                                        <Label Grid.Column="5" Text="{Binding TypeCode}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                                        <Label Grid.Column="6" Text="{Binding StatusText}" FontAttributes="Bold" VerticalTextAlignment="Center" Margin="4,0" FontSize="11" TextColor="Black"/>
                                        <Label Grid.Column="7" Text="{Binding StatusCode}" HorizontalTextAlignment="Center" VerticalTextAlignment="Center" FontSize="11" TextColor="Black"/>
                                    </Grid>
                                </DataTemplate>
                            </CollectionView.ItemTemplate>
                        </CollectionView>
                    </VerticalStackLayout>
                </ScrollView>
            </Border>

            <!-- 4. ПЕРЕКЛЮЧАТЕЛЬ БЛОКОВ (БВШ 1..4) -->
            <Label Text="Вибір блоку БВШ:" FontAttributes="Bold" FontSize="13" TextColor="#000080" Margin="2,4,0,0"/>
            <Grid ColumnDefinitions="*,*,*,*" ColumnSpacing="4">
                <Button x:Name="BtnBsh1" Grid.Column="0" Text="БВШ 1" BackgroundColor="#082044" TextColor="White" FontAttributes="Bold" FontSize="12" HeightRequest="36" CornerRadius="4" Clicked="OnSelectBshClicked"/>
                <Button x:Name="BtnBsh2" Grid.Column="1" Text="БВШ 2" BackgroundColor="#E0DFD8" TextColor="#333" FontAttributes="Bold" FontSize="12" HeightRequest="36" CornerRadius="4" Clicked="OnSelectBshClicked"/>
                <Button x:Name="BtnBsh3" Grid.Column="2" Text="БВШ 3" BackgroundColor="#E0DFD8" TextColor="#333" FontAttributes="Bold" FontSize="12" HeightRequest="36" CornerRadius="4" Clicked="OnSelectBshClicked"/>
                <Button x:Name="BtnBsh4" Grid.Column="3" Text="БВШ 4" BackgroundColor="#E0DFD8" TextColor="#333" FontAttributes="Bold" FontSize="12" HeightRequest="36" CornerRadius="4" Clicked="OnSelectBshClicked"/>
            </Grid>

            <!-- Кнопка считывания текущего выбранного блока -->
            <Button x:Name="BtnReadCurrent"
                    Text="Зчитати поточний БВШ 1"
                    BackgroundColor="#082044"
                    TextColor="White"
                    FontAttributes="Bold"
                    FontSize="13"
                    HeightRequest="40"
                    CornerRadius="4"
                    Clicked="OnReadCurrentBshClicked"/>

            <!-- 5. ТЕРМИНАЛ -->
            <Grid ColumnDefinitions="*,Auto" HeightRequest="36" Margin="0,2,0,0">
                <Label Grid.Column="0" Text="Термінал Bluetooth" TextColor="#000000" FontSize="14" FontAttributes="Bold" VerticalOptions="Center"/>
                <Switch Grid.Column="1" x:Name="TerminalSwitch" OnColor="#1046B0" VerticalOptions="Center" Toggled="OnTerminalToggled"/>
            </Grid>

            <Border x:Name="TerminalBorder" IsVisible="False" Stroke="#7F9DB9" StrokeThickness="1" BackgroundColor="#4A9192" Padding="8" HeightRequest="250">
                <Grid RowDefinitions="Auto,*">
                    <HorizontalStackLayout Grid.Row="0" Spacing="8" Margin="0,0,0,4">
                        <Label Text="🖥️ Дані обміну" FontAttributes="Bold" FontSize="13" TextColor="Black" VerticalOptions="Center"/>
                        <Button Text="🗑️ Очистити" BackgroundColor="White" TextColor="Black" FontSize="12" Padding="8,2" CornerRadius="4" Clicked="OnClearTerminalClicked"/>
                    </HorizontalStackLayout>
                    <ScrollView Grid.Row="1" x:Name="scrollView">
                        <Label x:Name="label4" Text="" FontAttributes="Bold" FontSize="12" TextColor="Black" LineBreakMode="WordWrap"/>
                    </ScrollView>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>