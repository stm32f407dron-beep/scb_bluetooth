<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:skb_home"
             x:Class="skb_home.Varta_832"
             Title="Varta_832"
             BackgroundColor="#40737a">



    <ContentPage.Resources>
        <ResourceDictionary>
            <local:StatusColorConverter x:Key="StatusToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>



    <ScrollView>
        <VerticalStackLayout Padding="8" Spacing="10">

            <!-- Таблица БША: центрируем блок на экране -->
            <CollectionView ItemsSource="{Binding Frames}"
                            HorizontalOptions="Center">
                <CollectionView.ItemsLayout>
                    <!-- Зазор между рамками делаем 8 (или 10) -->
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Рамка вокруг каждого БША: ширина 175 -->
                        <Border Stroke="#0B0101"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#E9F1F2"
                                WidthRequest="175"
                                Padding="8">

                            <VerticalStackLayout Spacing="3">
                                <!-- Заголовок -->
                                <Label Text="{Binding Headers}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#752108"
                                       HorizontalOptions="Center" />

                                <BoxView HeightRequest="1" Color="#B0BEC5" Margin="0,2,0,4"/>

                                <!-- Первая строка: BSVH и статус -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <Label Text="BSVH" FontAttributes="Bold" TextColor="#000000" FontSize="14" Grid.Column="0"/>
                                    <Label Text="{Binding Exists}" HorizontalTextAlignment="End"   FontAttributes="Bold" TextColor="#0D47A1" FontSize="14" Grid.Column="1"/>
                                </Grid>

                                <!-- 16 строк ШС -->
                                <CollectionView ItemsSource="{Binding Values}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="2"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold"
                                                       FontSize="14"
                                                       TextColor="#752108"
                                                       Grid.Column="0"/>
                                                <Label Text="{Binding Value}"
                                                       FontAttributes="Bold"
                                                       FontSize="14"
                                                       TextColor="{Binding Value, Converter={StaticResource StatusToColor}}"
                                                       HorizontalTextAlignment="End"
                                                       Grid.Column="1"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Две кнопки ровно под рамками: отцентрированы и точно такой же ширины (175) -->
            <Grid ColumnDefinitions="Auto,Auto"
                  ColumnSpacing="8"
                  HorizontalOptions="Center">

                <Button Grid.Column="0"
                        Text="Зчитати BSVH 1"
                        BackgroundColor="#082044"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        WidthRequest="175"
                        HeightRequest="42"
                        CornerRadius="6"
                        Clicked="OnReadBsvh1Clicked"/>

                <Button Grid.Column="1"
                        Text="Зчитати BSVH 2"
                        BackgroundColor="#082044"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="14"
                        WidthRequest="175"
                        HeightRequest="42"
                        CornerRadius="6"
                        Clicked="OnReadBsvh2Clicked"/>
            </Grid>

            <!-- Переключатель терминала -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10"
                  HeightRequest="50"
                  WidthRequest="358"
                  HorizontalOptions="Center">
                <Label Grid.Column="0"
                       Margin="4,15,0,0"
                       Text="Включити термінал"
                       TextColor="#FFFFFF"
                       FontSize="22"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Start">
                    <Label.Shadow>
                        <Shadow Brush="Black" Radius="8" Offset="2,2" Opacity="0.6"/>
                    </Label.Shadow>
                </Label>

                <Switch Grid.Column="2"
                        x:Name="TerminalSwitch"
                        OnColor="#1046B0"
                        ThumbColor="White"
                        Margin="0,15,4,0"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        Toggled="OnTerminalToggled"/>
            </Grid>

            <!-- Терминал -->
            <Border x:Name="TerminalBorder"
                    IsVisible="False"
                    Stroke="#0B0101"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#4A9192"
                    Padding="10"
                    Margin="0,10,0,10"
                    HeightRequest="510"
                    WidthRequest="358"
                    HorizontalOptions="Center">

                <Grid RowDefinitions="Auto,*">
                    <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,5">
                        <Label Text="🖥️ Термінал"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#000000"
                               VerticalOptions="Center"/>

                        <Button Text="🗑️ Очистити"
                                BackgroundColor="#FFFFFF"
                                TextColor="#000000"
                                FontAttributes="Bold"
                                FontSize="14"
                                Padding="5,2"
                                CornerRadius="5"
                                Clicked="OnClearTerminalClicked"/>
                    </HorizontalStackLayout>

                    <ScrollView Grid.Row="1" x:Name="scrollView" VerticalOptions="Fill">
                        <Label x:Name="label4"
                               Text="Empty text to receive data"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="Black"
                               LineBreakMode="WordWrap"
                               VerticalTextAlignment="Start"
                               HorizontalTextAlignment="Start"/>
                    </ScrollView>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>