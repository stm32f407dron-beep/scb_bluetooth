<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="skb_home.Varta_832"
             Title="Varta_832"
             BackgroundColor="#40737a">

    <ScrollView>
        <VerticalStackLayout Padding="8" Spacing="10">

            <!-- Таблица БША: блоки выводятся горизонтально рядом -->
            <CollectionView ItemsSource="{Binding Frames}">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Рамка вокруг каждого БША -->
                        <Border Stroke="#0B0101"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#E9F1F2"
                                WidthRequest="170"
                                Padding="8">

                            <VerticalStackLayout Spacing="3">
                                <!-- Заголовок (например, 00003100 (Sub=01)) -->
                                <Label Text="{Binding Headers}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#0B3C5D"
                                       HorizontalOptions="Center" />

                                <BoxView HeightRequest="1" Color="#B0BEC5" Margin="0,2,0,4"/>

                                <!-- Первая строка: BSVH и твой Exists -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <Label Text="BSVH:" FontAttributes="Bold" TextColor="#000000" FontSize="13" Grid.Column="0"/>
                                    <Label Text="{Binding Exists}" FontAttributes="Bold" TextColor="#0D47A1" FontSize="13" Grid.Column="1"/>
                                </Grid>

                                <!-- 16 строк ШС -->
                                <CollectionView ItemsSource="{Binding Values}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="2"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>
                                            <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                <!-- Левая колонка: имя (зеленый) -->
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       TextColor="#1B5E20"
                                                       Grid.Column="0"/>
                                                <!-- Правая колонка: значение (темно-красный контрастный) -->
                                                <Label Text="{Binding Value}"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       TextColor="#B71C1C"
                                                       HorizontalTextAlignment="End"
                                                       Grid.Column="1"/>
                                            </Grid>
                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Две кнопки под блоками БША -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="10" Margin="4,2">
                <Button Grid.Column="0"
                        Text="Зчитати БША 1"
                        BackgroundColor="#1B5E20"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="42"
                        CornerRadius="6"
                        Clicked="OnReadBsvh1Clicked"/>

                <Button Grid.Column="1"
                        Text="Зчитати БША 2"
                        BackgroundColor="#1B5E20"
                        TextColor="#FFFFFF"
                        FontAttributes="Bold"
                        FontSize="12"
                        HeightRequest="42"
                        CornerRadius="6"
                        Clicked="OnReadBsvh2Clicked"/>
            </Grid>

            <!-- Переключатель терминала -->
            <Grid ColumnDefinitions="Auto,*,Auto"
                  ColumnSpacing="10"
                  HeightRequest="50"
                  WidthRequest="320">
                <Label Grid.Column="0"
                       Margin="4,15,0,0"
                       Text="Включити термінал"
                       TextColor="#FFFFFF"
                       FontSize="22"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Start">
                    <Label.Shadow>
                        <Shadow Brush="Black" Radius="8" Offset="2,2" Opacity="0.6"/>
                    </Label.Shadow>
                </Label>

                <Switch Grid.Column="2"
                        x:Name="TerminalSwitch"
                        OnColor="#1046B0"
                        ThumbColor="White"
                        Margin="0,15,4,0"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        Toggled="OnTerminalToggled"/>
            </Grid>

            <!-- Кнопка "Витягнути" -->
            <Button Text="⏏️ Витягнути"
                    BackgroundColor="#10950C"
                    TextColor="#000000"
                    FontAttributes="Bold"
                    FontSize="14"
                    Padding="2,1"
                    CornerRadius="3"
                    WidthRequest="90"
                    HorizontalOptions="Center"
                    Clicked="OnSaveTerminalClicked"/>

            <!-- Терминал -->
            <Border x:Name="TerminalBorder"
                    IsVisible="False"
                    Stroke="#0B0101"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#4A9192"
                    Padding="10"
                    Margin="0,10,0,10"
                    HeightRequest="510"
                    WidthRequest="345">

                <Grid RowDefinitions="Auto,*">
                    <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,5">
                        <Label Text="🖥️ Термінал"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#000000"
                               VerticalOptions="Center"/>

                        <Button Text="🗑️ Очистити"
                                BackgroundColor="#FFFFFF"
                                TextColor="#000000"
                                FontAttributes="Bold"
                                FontSize="14"
                                Padding="5,2"
                                CornerRadius="5"
                                Clicked="OnClearTerminalClicked"/>
                    </HorizontalStackLayout>

                    <ScrollView Grid.Row="1" x:Name="scrollView" VerticalOptions="Fill">
                        <Label x:Name="label4"
                               Text="Empty text to receive data"
                               FontAttributes="Bold"
                               FontSize="18"
                               TextColor="Black"
                               LineBreakMode="WordWrap"
                               VerticalTextAlignment="Start"
                               HorizontalTextAlignment="Start"/>
                    </ScrollView>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>