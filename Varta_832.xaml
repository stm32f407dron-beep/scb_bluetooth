<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:local="clr-namespace:skb_home"
             x:Class="skb_home.Varta_832"
             Title="Varta_832"
             BackgroundColor="#40737a">



    <ContentPage.ToolbarItems>
        <!--<ToolbarItem Text="🔄" Order="Primary" Priority="0" Clicked="OnRefreshClicked"/>-->
        <ToolbarItem Text="⚙" Order="Primary" Priority="1" Clicked="OnSettingsClicked"/>
    </ContentPage.ToolbarItems>




    <ContentPage.Resources>
        <ResourceDictionary>
            <local:StatusColorConverter x:Key="StatusToColor" />
        </ResourceDictionary>
    </ContentPage.Resources>

    <ScrollView>
        <!-- Главный контейнер: центрируется, на телефонах занимает доступную ширину, 
             а на планшетах ограничивается максимум в 500 dp, чтобы не расползаться -->
        <VerticalStackLayout Padding="8" 
                             Spacing="10"
                             MaximumWidthRequest="500"
                             HorizontalOptions="Center">

            <!-- Таблица БША -->
            <CollectionView ItemsSource="{Binding Frames}"
                            HorizontalOptions="Center">
                <CollectionView.ItemsLayout>
                    <LinearItemsLayout Orientation="Horizontal" ItemSpacing="8"/>
                </CollectionView.ItemsLayout>

                <CollectionView.ItemTemplate>
                    <DataTemplate>
                        <!-- Рамка: ширина 170 (влезает даже в экраны 360dp с учетом отступов),
                             но при этом может гибко адаптироваться -->
                        <Border Stroke="#0B0101"
                                StrokeThickness="1.5"
                                StrokeShape="RoundRectangle 8"
                                BackgroundColor="#E9F1F2"
                                WidthRequest="170"
                                Padding="8">

                            <VerticalStackLayout Spacing="3">
                                <!-- Заголовок --><!--
                                <Label Text="{Binding Headers}"
                                       FontAttributes="Bold"
                                       FontSize="13"
                                       TextColor="#752108"
                                       HorizontalOptions="Center" />

                                <BoxView HeightRequest="1" Color="#B0BEC5" Margin="0,2,0,4"/>-->

                                <!-- Первая строка: BSVH и статус --><!--
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                    <Label Text="BSVH" FontAttributes="Bold" TextColor="#000000" FontSize="14" Grid.Column="0"/>
                                    <Label Text="{Binding Exists}" HorizontalTextAlignment="End" FontAttributes="Bold" TextColor="#0D47A1" FontSize="14" Grid.Column="1"/>
                                </Grid>-->


                                <!-- Первая строка: BSVH + номер субиндекса и статус -->
                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                        <Label Text="{Binding SubIndex, StringFormat='БВШ №{0}'}" 
                                           FontAttributes="Bold" 
                                           TextColor="#000000" 
                                           FontSize="14" 
                                           Grid.Column="0"/>
                                    
                                        <!--<Label Text="{Binding Exists}" 
                                           HorizontalTextAlignment="End" 
                                           FontAttributes="Bold" 
                                           TextColor="#0D47A1" 
                                           FontSize="14" 
                                           Grid.Column="1"/>-->

                                        <Label Text="{Binding Adress, StringFormat='адреса-{0}'}" 
                                            HorizontalTextAlignment="End" 
                                            FontAttributes="Bold" 
                                            TextColor="#149C14" 
                                            FontSize="14" 
                                            Grid.Column="1"/>           




                                </Grid>     





                                <!-- 16 строк ШС -->
                                <CollectionView ItemsSource="{Binding Values}">
                                    <CollectionView.ItemsLayout>
                                        <LinearItemsLayout Orientation="Vertical" ItemSpacing="2"/>
                                    </CollectionView.ItemsLayout>
                                    <CollectionView.ItemTemplate>
                                        <DataTemplate>

                                            <VerticalStackLayout>

                                                <Grid ColumnDefinitions="Auto,*" ColumnSpacing="6">
                                                <Label Text="{Binding Name}"
                                                       FontAttributes="Bold"
                                                       FontSize="12"
                                                       TextColor="#752108"
                                                       Grid.Column="0"/>
                                                <Label Text="{Binding Value}"
                                                       FontAttributes="Bold"
                                                       FontSize="13"
                                                       TextColor="{Binding Value, Converter={StaticResource StatusToColor}}"
                                                       HorizontalTextAlignment="End"
                                                       Grid.Column="1"/>
                                                </Grid>

                                                <!-- Полоска: включается через триггер XAML только для "Тип ШС8" -->
                                                <BoxView HeightRequest="1"
                                                      Color="#000000"
                                                      HorizontalOptions="Fill"
                                                      Margin="0,4,0,3"
                                                      IsVisible="False">
                                                        <BoxView.Triggers>
                                                        <DataTrigger TargetType="BoxView"
                                                           Binding="{Binding Name}"
                                                            Value="Тип ШС8">        
                                                            <Setter Property="IsVisible" Value="True" />
                                                        </DataTrigger>
                                                    </BoxView.Triggers> 
                                                </BoxView>


                                            </VerticalStackLayout>

                                        </DataTemplate>
                                    </CollectionView.ItemTemplate>
                                </CollectionView>
                            </VerticalStackLayout>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>

            <!-- Две кнопки ровно под рамками: ширина 170 каждая (170 + 8 + 170 = 348) -->
            <!-- 4 кнопки под рамками: ровно по вашему стилю с Auto,Auto -->
            <Grid ColumnDefinitions="Auto,Auto"
      RowDefinitions="Auto,Auto"
      ColumnSpacing="8"
      RowSpacing="8"
      HorizontalOptions="Center">

                <!-- Ряд 0: БША 1 и БША 2 -->
                <Button Grid.Row="0" Grid.Column="0"
            Text="Зчитати BSVH 1"
            BackgroundColor="#082044"
            TextColor="#FFFFFF"
            FontAttributes="Bold"
            FontSize="13"
            WidthRequest="170"
            HeightRequest="42"
            CornerRadius="6"
            Clicked="OnReadBsvh1Clicked"/>

                <Button Grid.Row="0" Grid.Column="1"
            Text="Зчитати BSVH 2"
            BackgroundColor="#082044"
            TextColor="#FFFFFF"
            FontAttributes="Bold"
            FontSize="13"
            WidthRequest="170"
            HeightRequest="42"
            CornerRadius="6"
            Clicked="OnReadBsvh2Clicked"/>

                <!-- Ряд 1: БША 3 и БША 4 -->
                <Button Grid.Row="1" Grid.Column="0"
            Text="Зчитати BSVH 3"
            BackgroundColor="#082044"
            TextColor="#FFFFFF"
            FontAttributes="Bold"
            FontSize="13"
            WidthRequest="170"
            HeightRequest="42"
            CornerRadius="6"
            Clicked="OnReadBsvh3Clicked"/>

                <Button Grid.Row="1" Grid.Column="1"
            Text="Зчитати BSVH 4"
            BackgroundColor="#082044"
            TextColor="#FFFFFF"
            FontAttributes="Bold"
            FontSize="13"
            WidthRequest="170"
            HeightRequest="42"
            CornerRadius="6"
            Clicked="OnReadBsvh4Clicked"/>
            </Grid>

            <!-- Переключатель терминала: ширина ровно под блок кнопок (348 dp) -->
            <Grid ColumnDefinitions="*,Auto"
                  HeightRequest="50"
                  WidthRequest="348"
                  HorizontalOptions="Center">
                <Label Grid.Column="0"
                       Margin="0,15,0,0"
                       Text="Включити термінал"
                       TextColor="#FFFFFF"
                       FontSize="20"
                       FontAttributes="Bold"
                       VerticalOptions="Center"
                       HorizontalOptions="Start">
                    <Label.Shadow>
                        <Shadow Brush="Black" Radius="8" Offset="2,2" Opacity="0.6"/>
                    </Label.Shadow>
                </Label>

                <Switch Grid.Column="1"
                        x:Name="TerminalSwitch"
                        OnColor="#1046B0"
                        ThumbColor="White"
                        Margin="0,15,0,0"
                        VerticalOptions="Center"
                        HorizontalOptions="End"
                        Toggled="OnTerminalToggled"/>
            </Grid>

            <!-- Терминал: ширина точно 348 dp, идеально совпадает с колонками -->
            <Border x:Name="TerminalBorder"
                    IsVisible="False"
                    Stroke="#0B0101"
                    StrokeThickness="2"
                    StrokeShape="RoundRectangle 10"
                    BackgroundColor="#4A9192"
                    Padding="10"
                    Margin="0,10,0,10"
                    HeightRequest="510"
                    WidthRequest="348"
                    HorizontalOptions="Center">

                <Grid RowDefinitions="Auto,*">
                    <HorizontalStackLayout Grid.Row="0" Spacing="10" Margin="0,0,0,5">
                        <Label Text="🖥️ Термінал"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="#000000"
                               VerticalOptions="Center"/>

                        <Button Text="🗑️ Очистити"
                                BackgroundColor="#FFFFFF"
                                TextColor="#000000"
                                FontAttributes="Bold"
                                FontSize="14"
                                Padding="8,2"
                                CornerRadius="5"
                                Clicked="OnClearTerminalClicked"/>
                    </HorizontalStackLayout>

                    <ScrollView Grid.Row="1" x:Name="scrollView" VerticalOptions="Fill">
                        <Label x:Name="label4"
                               Text="Empty text to receive data"
                               FontAttributes="Bold"
                               FontSize="16"
                               TextColor="Black"
                               LineBreakMode="WordWrap"
                               VerticalTextAlignment="Start"
                               HorizontalTextAlignment="Start"/>
                    </ScrollView>
                </Grid>
            </Border>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>