<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"  
             BackgroundColor="#CC000000"
             x:Class="skb_home.IdentifierPage"
             Title="IdentifierPage">



    <ScrollView >
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Fill" 
                      BackgroundColor="#ECE9D8" Padding="16"  Margin="15"   MaximumWidthRequest="500"  Spacing="10">

            <Label Text="Редагування ідентифікаторів ШС " FontAttributes="Bold" FontSize="14" TextColor="Black" HorizontalOptions="Center"/>

             <!--Контейнер, куди програмно додадуться 8 рядків зі шлейфами--> 
            <VerticalStackLayout x:Name="Container8Loops" Spacing="6" />

             <!--Кнопки керування внизу--> 
            <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,10,0,0">
                <Button Grid.Column="0" Text="Скасувати" BackgroundColor="#A0A0A0" TextColor="White" 
                 FontAttributes="Bold" HeightRequest="40" Clicked="OnCancelClicked"/>

                <Button Grid.Column="1" Text="Зберегти" BackgroundColor="#5B4C14" TextColor="White" 
                 FontAttributes="Bold" HeightRequest="40" Clicked="OnSaveClicked"/>
            </Grid>

        </VerticalStackLayout>

    </ScrollView>


</ContentPage>