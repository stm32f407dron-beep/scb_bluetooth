<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="skb_home.EditTypesPopup"
             BackgroundColor="#CC000000"
             Title="EditTypesPopup">


    <ScrollView >
        <VerticalStackLayout VerticalOptions="Center" HorizontalOptions="Center" 
                         BackgroundColor="#ECE9D8" Padding="16" WidthRequest="340" Spacing="10">

             <Label Text="Редагування типів ШС (0-5)" FontAttributes="Bold" FontSize="14" TextColor="Black" HorizontalOptions="Center"/>

        <!-- Контейнер, куди програмно додадуться 8 рядків зі шлейфами -->
               <VerticalStackLayout x:Name="Container8Loops" Spacing="6" />

        <!-- Кнопки керування внизу -->
           <Grid ColumnDefinitions="*,*" ColumnSpacing="8" Margin="0,10,0,0">
               <Button Grid.Column="0" Text="Скасувати" BackgroundColor="#A0A0A0" TextColor="White" 
                    FontAttributes="Bold" HeightRequest="40" Clicked="OnCancelClicked"/>

                <Button Grid.Column="1" Text="Зберегти" BackgroundColor="#190649" TextColor="White" 
                    FontAttributes="Bold" HeightRequest="40" Clicked="OnSaveClicked"/>
           </Grid>

       </VerticalStackLayout>
        
    </ScrollView>
    
    
    
</ContentPage>